# Configuração do LLM para o AutoResearcher Agent
# Suporta qualquer endpoint OpenAI-compatible (Groq, OpenRouter, HuggingFace, Together, Ollama)

# Opção 1: OpenRouter / Groq / HuggingFace Serverless
AUTORESEARCHER_LLM_BASE_URL=https://openrouter.ai/api/v1
AUTORESEARCHER_LLM_API_KEY=your_api_key_here
AUTORESEARCHER_LLM_MODEL=qwen/qwen-2.5-7b-instruct

# Opção 2: Ollama Local (descomente para usar localmente sem chave externa)
# AUTORESEARCHER_LLM_BASE_URL=http://localhost:11434/v1
# AUTORESEARCHER_LLM_API_KEY=ollama
# AUTORESEARCHER_LLM_MODEL=qwen2.5:7b-instruct

# Modo do Agente: "auto" (usa LLM se API key estiver configurada, senão usa motor diagnóstico determinístico), "llm" ou "diagnostic_heuristic"
AUTORESEARCHER_AGENT_MODE=auto

# Diretório de Tracking do MLflow e Artefatos
AUTORESEARCHER_ARTIFACTS_DIR=artifacts
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
